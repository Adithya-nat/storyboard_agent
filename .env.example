# Copy to .env and fill in. Never put a real key in this committed file. See SETUP.md.

# --- Keys ---
GEMINI_API_KEY=
# Only needed if SCRIPT_MODEL (or another role) uses an anthropic:* model.
ANTHROPIC_API_KEY=

# --- Story defaults (the web app lets you pick per video) ---
DEFAULT_STYLE=dialogue        # dialogue | mixed | narrated
DEFAULT_LANGUAGE=en           # en | ta

# --- Models (validated at startup; /health lists what your key can see) ---
SCRIPT_MODEL=gemini-4-carbon
JUDGE_MODEL=gemini-4-argon
DESIGNER_MODEL=gemini-4-argon
PUBLISH_MODEL=gemini-4-argon
GEMINI_IMAGE_MODEL=gemini-3-pro-image
IMAGE_SIZE=2K
TTS_MODEL_CHAIN=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
# Created by `python -m scripts.design_voice`; empty -> TTS_VOICE.
NARRATOR_VOICE_ID=
TRANSCRIBE_MODEL=gemini-3.5-transcribe
MUSIC_MODEL_CHAIN=lyria-3.5,lyria-3-pro-preview,lyria-3-clip-preview
TEXT_RPM_LIMIT=300

# --- AI video ---
VIDEO_PROVIDER=omni           # omni | none | engine (legacy)
OMNI_MODEL_CHAIN=gemini-omni-1.2-flash,gemini-omni-1.1-flash
OMNI_RESOLUTION=1080p
OMNI_MAX_CONCURRENCY=6
OMNI_SPEAKER_CHECK=true
REQUIRE_AI_VIDEO=true         # never ship stills; stop + Resume instead
IMAGE_IDENTITY_CHECK=true     # re-render a frame once if a character doesn't match their sheet

# --- Film ---
SECONDS_PER_FRAME=4.0
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
ENABLE_TTS=true
BURN_SUBTITLES=false          # true = burn subtitles into the film
MUSIC_ENABLED=true
MUSIC_GAIN_DB=-14
AMBIENCE_GAIN_DB=-18

# --- Budget (app-side; Google billing is authoritative — see SETUP.md) ---
MONTHLY_BUDGET_USD=300
BUDGET_MODE=block             # block | degrade
BUDGET_WARN_FRACTION=0.8
SPEND_RATE_LIMIT_USD_PER_10MIN=180   # Google Tier 2+ = $200 / 10 min; set 9 on Tier 1

# --- Hosting: sign-in + bring-your-own-key (see DEPLOY.md; leave as-is for local use) ---
# none = one local user, no sign-in | jwt = tokens from the web app's Better Auth
AUTH_MODE=none
# e.g. https://app.example.com/api/auth/jwks and https://app.example.com
AUTH_JWKS_URL=
AUTH_ISSUER=
# Who may make films in hosted mode: emails, @domain.com, or * for anyone signed in.
ALLOWED_USERS=
# server = GEMINI_API_KEY above | byok = every user brings their own key
KEY_MODE=server
# Signs media links; generate with: openssl rand -hex 32
ASSET_SIGNING_SECRET=
USER_MONTHLY_BUDGET_USD=50
MAX_ACTIVE_JOBS_PER_USER=1
MAX_ACTIVE_JOBS=3

# --- Infra ---
# Local Docker Postgres. For Neon, paste the DIRECT (not -pooler) connection string; it is converted for you.
DATABASE_URL=postgresql+asyncpg://storyboard:storyboard@localhost:5432/storyboard
ARTIFACT_ROOT=./artifacts_store
CORS_ORIGINS=http://localhost:3000
# Product rule: a film's prompt, script, media and logs are deleted 24h after it starts (hosted mode caps
# this at 86400). Cost totals, without the prompt, are kept for the usage page.
JOB_TTL_SECONDS=86400
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE=5/minute;30/day
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- Legacy motion engine (only with VIDEO_PROVIDER=engine) ---
MOTION_ENGINE_ENABLED=false
MOTION_ENGINE_URL=http://localhost:8090
