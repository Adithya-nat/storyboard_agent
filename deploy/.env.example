# Everything the hosted server needs, in one file. Copy to deploy/.env (gitignored).

# Domains pointing at this server (see DEPLOY.md for free sslip.io names).
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Neon: the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32
ASSET_SIGNING_SECRET=

# OAuth apps (callbacks: https://APP_DOMAIN/api/auth/callback/github and .../google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Beta allowlist: emails or @domain.com, comma separated. * = anyone who signs in.
ALLOWED_USERS=you@example.com

USER_MONTHLY_BUDGET_USD=50
MAX_ACTIVE_JOBS=3

# Where creator-agent-web is checked out (default: next to this repo).
# WEB_DIR=/absolute/path/to/creator-agent-web
